---
// src/pages/[...slug].astro
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries
    .map(entry => {
      let slug = entry.id;
      
      // 处理子目录下的 index.md 路由映射，如 finance/index.md 应该映射为 /finance
      if (slug.endsWith('/index')) {
        slug = slug.substring(0, slug.lastIndexOf('/index'));
      } else if (slug === 'index') {
        // 排除根路径的 index.md，因为我们已单独实现 index.astro 首页
        return null;
      }
      
      return {
        params: { slug },
        props: { entry },
      };
    })
    .filter((item): item is { params: { slug: string }; props: { entry: any } } => item !== null);
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const currentPath = Astro.url.pathname;
---

<PostLayout 
  title={entry.data.title} 
  description={entry.data.description} 
  headings={headings}
  currentPath={currentPath}
>
  <Content />
</PostLayout>
