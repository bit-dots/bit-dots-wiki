---
// src/pages/[...slug].astro
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const wikiEntries = await getCollection('wiki');
  return wikiEntries
    .map(entry => {
      let slug = entry.id;
      if (slug.endsWith('/index')) {
        slug = slug.substring(0, slug.lastIndexOf('/index'));
      } else if (slug === 'index') {
        return null;
      }
      return {
        params: { slug },
        props: { entry, allEntries: wikiEntries },
      };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null);
}

const { entry, allEntries } = Astro.props;
const { Content, headings } = await render(entry);
const currentPath = Astro.url.pathname;

// 推荐同分类文章（排除自身，最多 4 篇）
const currentCategory = entry.id.split('/')[0]; // tech / finance / etc
const relatedPosts = allEntries
  .filter((e: any) => {
    if (e.id === entry.id) return false;
    if (e.id === 'index' || e.id.endsWith('/index')) return false;
    return e.id.startsWith(currentCategory + '/');
  })
  .slice(0, 4);
---

<PostLayout 
  title={entry.data.title} 
  description={entry.data.description} 
  headings={headings}
  currentPath={currentPath}
  relatedPosts={relatedPosts}
>
  <Content />
</PostLayout>
