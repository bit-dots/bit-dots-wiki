---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Bit-Dots - 极简个人知识 Wiki", 
  description = "点滴成海，记录万物。一个极简、纯粹、高颜值的个人知识空间。" 
} = Astro.props;

const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

// 导航链接定义
const navLinks = [
  { text: '首页', href: '/', icon: '🏠' },
  { text: '笔记', href: '/intro', icon: '📝' },
  { text: '复利', href: '/finance', icon: '📈' },
  { text: '关于', href: '/about', icon: 'ℹ️' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="Bit-Dots, Wiki, 知识库, 个人博客, 极简设计, Astro" />
    <meta name="author" content="Bit-Dots" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Bit-Dots" />
    <script is:inline>
      (function() {
        var html = document.documentElement;
        function initTheme() {
          var t = localStorage.getItem('theme');
          if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
          html.setAttribute('data-theme', t);
        }
        // 初始化
        initTheme();
        // Astro transitions 后重新初始化
        document.addEventListener('astro:after-swap', initTheme);
      })();
    </script>
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <!-- 导航栏 -->
    <header class="nav-header">
      <div class="nav-inner">
        <a href="/" class="nav-brand">
          <img src="/logo.svg" alt="Bit-Dots" class="nav-logo" />
          <span class="brand-text">Bit-Dots</span>
        </a>
        <nav class="nav-menu">
          {navLinks.map(link => (
            <a 
              href={link.href}
              class:list={['nav-link', { active: isActive(link.href) }]}
            >
              <span class="nav-icon">{link.icon}</span>
              <span>{link.text}</span>
            </a>
          ))}
        </nav>
        <!-- 主题切换按钮 -->
        <button class="theme-toggle" id="theme-toggle" aria-label="切换深色模式">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
          </svg>
        </button>
        <SearchModal />
        <!-- 移动端汉堡菜单按钮 -->
        <button class="menu-toggle" id="menu-toggle" aria-label="切换菜单">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <!-- 移动端菜单面板 -->
    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav">
        {navLinks.map(link => (
          <a href={link.href} class="mobile-link">{link.icon} {link.text}</a>
        ))}
      </nav>
    </div>

    <!-- 主内容 -->
    <div class="page-shell">
      <slot />
    </div>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img src="/logo.svg" alt="Bit-Dots" class="footer-logo" />
          <p class="footer-tagline">点滴成海，记录万物</p>
        </div>
        <div class="footer-links">
          <a href="/">首页</a>
          <a href="/intro">笔记</a>
          <a href="/finance">复利</a>
          <a href="/about">关于</a>
          <a href="https://github.com/bit-dots/bit-dots-wiki" target="_blank">GitHub</a>
        </div>
        <div class="footer-copy">
          <p>本站内容采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank">CC BY-NC-SA 4.0</a> 协议</p>
          <p>© 2026–{currentYear} Bit-Dots · Powered by <a href="https://astro.build" target="_blank">Astro</a></p>
        </div>
      </div>
    </footer>

    <!-- 主题切换 JS -->
    <script>
      (function() {
        var html = document.documentElement;
        var btn = null;
        var sun = null;
        var moon = null;

        function getTheme() {
          return html.getAttribute('data-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        }

        function updateThemeIcons(theme) {
          if (!sun || !moon) return;
          if (theme === 'dark') {
            sun.style.display = 'none';
            moon.style.display = 'block';
          } else {
            sun.style.display = 'block';
            moon.style.display = 'none';
          }
        }

        function applyTheme(t) {
          html.setAttribute('data-theme', t);
          localStorage.setItem('theme', t);
          updateThemeIcons(t);
        }

        function initThemeElements() {
          btn = document.getElementById('theme-toggle');
          sun = document.querySelector('.icon-sun');
          moon = document.querySelector('.icon-moon');
        }

        function initThemeToggle() {
          initThemeElements();
          if (!btn) return;
          btn.onclick = function() {
            applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
          };
        }

        function init() {
          initThemeElements();
          var theme = localStorage.getItem('theme');
          if (!theme) {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          html.setAttribute('data-theme', theme);
          updateThemeIcons(theme);
          initThemeToggle();
        }

        // 初始化
        init();

        // Astro transitions 兼容
        if (window.addEventListener) {
          document.addEventListener('astro:after-swap', init);
        }

        // 跨标签页同步
        window.addEventListener('storage', function(e) {
          if (e.key === 'theme' && e.newValue) {
            applyTheme(e.newValue);
          }
        });

        // 无手动偏好时跟随系统变化
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('theme')) {
            applyTheme(e.matches ? 'dark' : 'light');
          }
        });
      })();
    </script>

    <!-- 移动菜单 JS -->
    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        menu?.classList.toggle('open');
        toggle.classList.toggle('open');
      });
    </script>
  </body>
</html>

<style>
  /* ========= 导航栏 ========= */
  .nav-header {
    position: sticky; top: 0; z-index: 100;
    height: 64px;
    background: rgba(255,255,255,.78);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--vp-c-divider);
    transition: background .3s;
  }
  @media (prefers-color-scheme: dark) {
    .nav-header { background: rgba(27,27,31,.78); }
  }
  [data-theme="dark"] .nav-header { background: rgba(27,27,31,.78); }
  [data-theme="light"] .nav-header { background: rgba(255,255,255,.78); }
  .nav-inner {
    max-width: var(--max-width); margin: 0 auto;
    height: 100%; padding: 0 24px;
    display: flex; align-items: center; justify-content: space-between;
  }

  /* Brand */
  .nav-brand {
    display: flex; align-items: center; gap: 10px;
    color: var(--vp-c-text-1); font-weight: 700; font-size: 1.15rem;
  }
  .nav-logo {
    width: 30px; height: 30px;
    filter: drop-shadow(0 2px 6px rgba(230,57,70,.18));
    transition: transform .3s;
  }
  .nav-brand:hover .nav-logo { transform: rotate(12deg) scale(1.08); }

  /* 导航链接 */
  .nav-menu { display: flex; gap: 6px; }
  .nav-link {
    display: flex; align-items: center; gap: 5px;
    padding: 6px 14px; border-radius: 10px;
    font-size: .9rem; font-weight: 500;
    color: var(--vp-c-text-2);
    transition: all .2s ease;
  }
  .nav-icon { font-size: .95rem; }
  .nav-link:hover {
    background: var(--vp-c-bg-soft); color: var(--vp-c-text-1);
  }
  .nav-link.active {
    background: var(--vp-c-brand-soft); color: var(--vp-c-brand-1);
    font-weight: 600;
  }

  /* 主题切换按钮 */
  .theme-toggle {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 10px;
    background: none; border: none; cursor: pointer;
    color: var(--vp-c-text-2);
    transition: all .2s ease;
    margin-left: 4px;
  }
  .theme-toggle:hover {
    background: var(--vp-c-bg-soft); color: var(--vp-c-brand-1);
  }
  /* 图标仅在对应主题下显示 */
  .icon-sun,
  .icon-moon {
    display: none;
  }
  [data-theme="light"] .icon-sun {
    display: block;
  }
  [data-theme="dark"] .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :not([data-theme]) .icon-moon {
      display: block;
    }
    :not([data-theme]) .icon-sun {
      display: none;
    }
  }

  /* 汉堡按钮 */
  .menu-toggle {
    display: none;
    flex-direction: column; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 4px;
  }
  .menu-toggle span {
    width: 22px; height: 2px; background: var(--vp-c-text-1);
    border-radius: 2px; transition: all .25s ease;
  }
  .menu-toggle.open span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

  /* 移动菜单 */
  .mobile-menu {
    display: none;
    position: fixed; top: 64px; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,.95);
    backdrop-filter: blur(24px);
    z-index: 99;
    padding: 24px;
    transform: translateY(-10px); opacity: 0;
    transition: all .3s ease; pointer-events: none;
  }
  @media (prefers-color-scheme: dark) {
    .mobile-menu { background: rgba(27,27,31,.95); }
  }
  [data-theme="dark"] .mobile-menu { background: rgba(27,27,31,.95); }
  [data-theme="light"] .mobile-menu { background: rgba(255,255,255,.95); }
  .mobile-menu.open { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .mobile-nav { display: flex; flex-direction: column; gap: 8px; }
  .mobile-link {
    font-size: 1.1rem; font-weight: 500; padding: 14px 16px;
    border-radius: 12px; color: var(--vp-c-text-1);
    transition: background .2s;
  }
  .mobile-link:hover { background: var(--vp-c-bg-soft); }

  /* ========= 主内容区 ========= */
  .page-shell {
    min-height: calc(100vh - 64px - 200px);
  }

  /* ========= 页脚 ========= */
  .site-footer {
    border-top: 1px solid var(--vp-c-divider);
    background: var(--vp-c-bg-soft);
    padding: 48px 24px 36px;
  }
  .footer-inner {
    max-width: var(--max-width); margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 24px;
    text-align: center;
  }
  .footer-logo { width: 36px; height: 36px; opacity: .6; }
  .footer-tagline { margin: 8px 0 0; font-size: .9rem; color: var(--vp-c-text-2); }
  .footer-links { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }
  .footer-links a {
    font-size: .88rem; color: var(--vp-c-text-2);
    transition: color .2s;
  }
  .footer-links a:hover { color: var(--vp-c-brand-1); }
  .footer-copy { font-size: .82rem; color: var(--vp-c-text-2); }
  .footer-copy p { margin: 4px 0; }
  .footer-copy a { text-decoration: underline; color: var(--vp-c-text-2); }
  .footer-copy a:hover { color: var(--vp-c-brand-1); }

  /* ========= 响应式 ========= */
  @media (max-width: 768px) {
    .nav-menu { display: none; }
    .menu-toggle { display: flex; }
    .mobile-menu { display: block; }
    .site-footer { padding: 36px 16px 28px; }
    .footer-links { gap: 14px; }
  }
</style>
