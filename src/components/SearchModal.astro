---
// src/components/SearchModal.astro
const isDev = import.meta.env?.DEV;
---

<!-- 搜索触发按钮 -->
<button class="search-trigger" id="search-trigger" aria-label="搜索文档" title="搜索 (Ctrl+K)">
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
  </svg>
</button>

<!-- 搜索弹窗（仅生产环境可用） -->
{!isDev && (
<div class="search-overlay" id="search-overlay">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-modal">
    <div class="search-header">
      <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="搜索文档..."
        autocomplete="off"
      />
      <kbd class="search-kbd">ESC</kbd>
    </div>
    <div class="search-body">
      <div class="search-status" id="search-status">输入关键词开始搜索</div>
      <div class="search-results" id="search-results"></div>
    </div>
  </div>
</div>
)}

<script>
  (function() {
    var trigger = document.getElementById('search-trigger');
    var overlay = document.getElementById('search-overlay');
    if (!trigger || !overlay) return;

    var backdrop = document.getElementById('search-backdrop');
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var status = document.getElementById('search-status');

    var pagefind = null;
    var selectedIdx = -1;
    var currentResults = [];
    var debounceTimer = null;

    // 首次打开时懒加载 Pagefind
    async function loadPagefind() {
      if (pagefind) return pagefind;
      try {
        var pfPath = '/pagefind/pagefind.js';
        var mod = await import(/* @vite-ignore */ pfPath);
        pagefind = mod;
        await pagefind.init();
        status.textContent = '输入关键词开始搜索';
        return pagefind;
      } catch (e) {
        status.textContent = '搜索功能暂不可用';
        status.className = 'search-status empty';
        return null;
      }
    }

    function open() {
      overlay.classList.add('open');
      setTimeout(function() { input.focus(); }, 100);
      document.body.style.overflow = 'hidden';
      loadPagefind();
    }

    function close() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      input.value = '';
      results.innerHTML = '';
      status.textContent = '输入关键词开始搜索';
      status.className = 'search-status';
      selectedIdx = -1;
      currentResults = [];
    }

    async function doSearch(query) {
      if (!pagefind) return;
      if (!query.trim()) {
        results.innerHTML = '';
        status.textContent = '输入关键词开始搜索';
        status.className = 'search-status';
        return;
      }
      status.textContent = '搜索中...';
      status.className = 'search-status';
      try {
        var search = await pagefind.search(query, {});
        currentResults = search.results;
        if (!search.results.length) {
          results.innerHTML = '';
          status.textContent = '未找到相关结果';
          status.className = 'search-status empty';
        } else {
          status.textContent = '';
          status.className = 'search-status';
          renderResults(search.results.slice(0, 10));
        }
      } catch (e) {
        status.textContent = '搜索出错，请重试';
        status.className = 'search-status empty';
      }
    }

    async function renderResults(items) {
      var html = '';
      for (var i = 0; i < items.length; i++) {
        var data = await items[i].data();
        html += '<a href="' + data.url + '" class="search-result-item" data-idx="' + i + '">' +
          '<span class="result-title">' + escapeHtml(data.meta.title || data.url) + '</span>' +
          '<span class="result-excerpt">' + (data.excerpt || '') + '</span>' +
          '</a>';
      }
      results.innerHTML = html;
    }

    function escapeHtml(text) {
      var d = document.createElement('div');
      d.textContent = text;
      return d.innerHTML;
    }

    function updateSelection() {
      var items = results.querySelectorAll('.search-result-item');
      items.forEach(function(item, i) {
        item.classList.toggle('selected', i === selectedIdx);
      });
    }

    // 事件监听
    trigger.addEventListener('click', open);

    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', function(e) {
      if (!overlay.classList.contains('open')) return;

      if (e.key === 'Escape') { e.preventDefault(); close(); return; }

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, currentResults.length - 1);
        updateSelection();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, 0);
        updateSelection();
      }
      if (e.key === 'Enter' && selectedIdx >= 0) {
        e.preventDefault();
        var items = results.querySelectorAll('.search-result-item');
        if (items[selectedIdx]) items[selectedIdx].click();
      }
    });

    input.addEventListener('input', function() {
      selectedIdx = -1;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function() {
        doSearch(input.value);
      }, 300);
    });

    // Ctrl+K / Cmd+K 快捷键
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        open();
      }
    });
  })();
</script>

<style>
  .search-trigger {
    display: flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 10px;
    background: none; border: none; cursor: pointer;
    color: var(--vp-c-text-2);
    transition: all .2s ease;
    margin-left: 4px;
  }
  .search-trigger:hover {
    background: var(--vp-c-bg-soft); color: var(--vp-c-brand-1);
  }

  /* ========= 搜索弹窗 ========= */
  .search-overlay {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: flex-start; justify-content: center;
    padding-top: 15vh;
    opacity: 0; pointer-events: none;
    transition: opacity .2s ease;
  }
  .search-overlay.open {
    opacity: 1; pointer-events: auto;
  }

  .search-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,.25);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  [data-theme="dark"] .search-backdrop { background: rgba(0,0,0,.5); }

  .search-modal {
    position: relative; z-index: 1;
    width: 90%; max-width: 560px; max-height: 60vh;
    background: var(--vp-c-bg);
    border: 1px solid var(--vp-c-divider);
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0,0,0,.12);
    display: flex; flex-direction: column;
    overflow: hidden;
  }

  .search-header {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--vp-c-divider);
  }
  .search-input-icon { color: var(--vp-c-text-2); flex-shrink: 0; }
  .search-input {
    flex: 1; border: none; background: none;
    font-size: .95rem; font-family: inherit;
    color: var(--vp-c-text-1); outline: none;
  }
  .search-input::placeholder { color: var(--vp-c-text-2); }
  .search-kbd {
    font-size: .7rem; padding: 2px 6px; border-radius: 4px;
    background: var(--vp-c-bg-soft); color: var(--vp-c-text-2);
    border: 1px solid var(--vp-c-divider);
    font-family: inherit; flex-shrink: 0;
  }

  .search-body {
    overflow-y: auto; flex: 1;
    padding: 8px;
  }

  .search-status {
    padding: 24px 12px; text-align: center;
    color: var(--vp-c-text-2); font-size: .88rem;
  }

  .search-results {
    display: flex; flex-direction: column; gap: 2px;
  }

  .search-result-item {
    display: block; padding: 10px 12px; border-radius: 8px;
    color: var(--vp-c-text-1); transition: background .15s;
    text-decoration: none;
  }
  .search-result-item:hover,
  .search-result-item.selected {
    background: var(--vp-c-bg-soft);
  }
  .result-title {
    display: block; font-weight: 600; font-size: .9rem;
    margin-bottom: 3px;
  }
  .result-excerpt {
    display: block; font-size: .8rem; color: var(--vp-c-text-2);
    line-height: 1.5;
  }
</style>

<style is:global>
  /* Pagefind 生成的 mark 标签需要全局样式 */
  .result-excerpt mark {
    background: var(--vp-c-brand-soft);
    color: var(--vp-c-brand-1);
    border-radius: 2px;
    padding: 0 2px;
  }
</style>
