---
// src/components/HomePortal.astro
import { getCollection } from 'astro:content';
import StatsCard from './StatsCard.astro';
import TagCloud from './TagCloud.astro';

// 获取最新文章用于首页"最近更新"
const allPosts = await getCollection('wiki');
const recentPosts = allPosts
  .filter(p => p.id !== 'index' && !p.id.endsWith('/index'))
  .sort((a, b) => {
    const dateA = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
    const dateB = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 6);

const getCategoryLabel = (id: string) => {
  if (id.startsWith('finance')) return '📈 复利';
  if (id.startsWith('tech')) return '🚀 技术';
  return '📝 笔记';
};

const getCategoryLink = (id: string) => {
  const cat = id.split('/')[0];
  return `/${cat}`;
};
---

<div class="portal">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="gradient">Bit-Dots</span>
      </h1>
      <p class="hero-subtitle">点滴成海，记录万物</p>
      <p class="hero-desc">一个极简、纯粹的个人知识空间 ——<br/>每一篇笔记都是一颗 Dot，持续积累终将连点成线。</p>
      <div class="hero-actions">
        <a href="/" class="btn-primary">
          <span>🚀</span> 开始探索
        </a>
        <a href="/about" class="btn-ghost">
          关于本站 →
        </a>
      </div>
    </div>
  </section>

  <!-- 统计卡片 -->
  <section class="section-block">
    <StatsCard />
  </section>

  <!-- Bento Grid 板块入口 -->
  <section class="section-block">
    <h2 class="section-title">📂 知识板块</h2>
    <div class="bento">
      <a href="/tech" class="bento-card card-tech">
        <div class="card-icon">🚀</div>
        <h3>技术探索</h3>
        <p>Vue, AI, 效率工具与代码实践</p>
        <span class="card-arrow">→</span>
      </a>
      <a href="/finance" class="bento-card card-finance">
        <div class="card-icon">💹</div>
        <h3>金融洞察</h3>
        <p>市场分析、投资笔记与理财思考</p>
        <span class="card-arrow">→</span>
      </a>
      <div class="bento-card card-life card-wip">
        <div class="card-icon">☕</div>
        <h3>生活随笔</h3>
        <p>摄影、旅行与感悟</p>
        <span class="wip-tag">即将推出</span>
      </div>
      <div class="bento-card card-project card-wip">
        <div class="card-icon">📁</div>
        <h3>项目档案</h3>
        <p>创造记录与实验性项目</p>
        <span class="wip-tag">即将推出</span>
      </div>
    </div>
  </section>

  <!-- 标签云 -->
  <section class="section-block">
    <h2 class="section-title">🏷️ 热门标签</h2>
    <TagCloud />
  </section>

  <!-- 最近更新 -->
  {recentPosts.length > 0 && (
    <section class="section-block">
      <h2 class="section-title">🕐 最近更新</h2>
      <div class="recent-list">
        {recentPosts.map(post => {
          let url = `/${post.id}`;
          return (
            <a href={url} class="recent-item">
              <div class="recent-header">
                <span class="recent-cat">{getCategoryLabel(post.id)}</span>
                {post.data.pubDate && (
                  <time class="recent-date">
                    {new Date(post.data.pubDate).toLocaleDateString('zh-CN')}
                  </time>
                )}
              </div>
              <h4>{post.data.title || post.id.split('/').pop()}</h4>
              {post.data.description && <p>{post.data.description}</p>}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="recent-tags">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="mini-tag" key={tag}>{tag}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="cta-content">
      <h2>探索更多内容</h2>
      <p>浏览完整的知识库，发现更多有趣的想法和见解</p>
      <a href="/finance" class="btn-cta">浏览投资笔记 →</a>
    </div>
  </section>
</div>

<style>
  .portal {
    max-width: 1080px; margin: 0 auto; padding: 0 20px 80px;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative; text-align: center;
    padding: 100px 0 80px; overflow: hidden;
  }
  .hero-glow {
    position: absolute; top: -40%; left: 50%; transform: translateX(-50%);
    width: 600px; height: 600px; border-radius: 50%;
    background: radial-gradient(circle, rgba(230,57,70,.08) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-content { position: relative; z-index: 2; }
  .hero-title {
    font-size: 4.5rem; font-weight: 800; margin: 0; letter-spacing: -2px;
    line-height: 1.1;
  }
  .gradient {
    background: linear-gradient(135deg, #e63946 0%, #457b9d 50%, #1d3557 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    animation: gradShift 6s ease-in-out infinite;
  }
  @keyframes gradShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .hero-subtitle {
    font-size: 1.6rem; color: var(--vp-c-text-2); margin: 16px 0 12px;
    font-weight: 500;
  }
  .hero-desc {
    font-size: 1rem; color: var(--vp-c-text-2); line-height: 1.7;
    margin: 0 auto 36px; max-width: 480px;
  }
  .hero-actions { display: flex; gap: 14px; justify-content: center; }

  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 32px; border-radius: 14px;
    background: linear-gradient(135deg, #e63946, #c1121f);
    color: white; font-weight: 600; font-size: .95rem;
    transition: all .3s ease;
    box-shadow: 0 4px 16px rgba(230,57,70,.25);
    text-decoration: none;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(230,57,70,.35);
  }
  .btn-ghost {
    padding: 14px 28px; border-radius: 14px;
    border: 1px solid var(--vp-c-divider);
    color: var(--vp-c-text-1); font-weight: 500; font-size: .95rem;
    transition: all .25s;
    text-decoration: none;
  }
  .btn-ghost:hover {
    background: var(--vp-c-bg-soft); border-color: var(--vp-c-brand-1);
    color: var(--vp-c-brand-1);
  }

  /* ---- Section ---- */
  .section-block { margin-top: 72px; }
  .section-title {
    font-size: 1.5rem; font-weight: 700; margin: 0 0 28px;
    letter-spacing: -.2px;
  }

  /* ---- Bento Grid ---- */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    gap: 16px;
  }
  .bento-card {
    background: var(--vp-c-bg-soft); border: 1px solid var(--vp-c-divider);
    border-radius: 20px; padding: 28px;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    transition: all .35s cubic-bezier(.4,0,.2,1);
  }

  a.bento-card { cursor: pointer; color: var(--vp-c-text-1); text-decoration: none; }
  a.bento-card:hover {
    transform: translateY(-6px);
    border-color: var(--vp-c-brand-1);
    box-shadow: 0 12px 32px rgba(0,0,0,.08);
  }
  a.bento-card:hover .card-arrow {
    transform: translateX(4px); opacity: 1;
  }

  .card-tech { grid-column: span 2; grid-row: span 2; }
  .card-finance { grid-column: span 2; }

  .card-icon { font-size: 2.2rem; margin-bottom: 14px; }
  .bento-card h3 { margin: 0; font-size: 1.2rem; font-weight: 700; }
  .bento-card p { margin: 8px 0 0; font-size: .88rem; color: var(--vp-c-text-2); line-height: 1.5; }
  .card-arrow {
    position: absolute; bottom: 24px; right: 24px;
    font-size: 1.2rem; color: var(--vp-c-brand-1);
    opacity: 0; transform: translateX(0);
    transition: all .25s ease;
  }

  .card-wip {
    opacity: .55; cursor: default;
  }
  .wip-tag {
    position: absolute; top: 16px; right: 16px;
    font-size: .7rem; font-weight: 700;
    padding: 3px 10px; border-radius: 10px;
    background: var(--vp-c-divider); color: var(--vp-c-text-2);
  }

  /* ---- 最近更新 ---- */
  .recent-list {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
  }
  .recent-item {
    background: var(--vp-c-bg-soft); border: 1px solid var(--vp-c-divider);
    border-radius: 14px; padding: 20px 24px;
    display: flex; flex-direction: column;
    transition: all .3s ease;
    text-decoration: none;
  }
  .recent-item:hover {
    transform: translateY(-3px); border-color: var(--vp-c-brand-1);
    box-shadow: 0 6px 20px rgba(0,0,0,.05);
  }

  .recent-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 8px;
  }

  .recent-cat {
    font-size: .75rem; font-weight: 700; color: var(--vp-c-brand-1);
  }

  .recent-date {
    font-size: .75rem; color: var(--vp-c-text-2);
  }

  .recent-item h4 {
    margin: 0 0 6px; font-size: 1.05rem; font-weight: 700;
    color: var(--vp-c-text-1);
  }
  .recent-item p {
    margin: 0 0 12px; font-size: .84rem; color: var(--vp-c-text-2); line-height: 1.5;
  }

  .recent-tags {
    display: flex; gap: 6px; flex-wrap: wrap;
  }

  .mini-tag {
    display: inline-block;
    padding: 2px 8px;
    background: color-mix(in srgb, var(--vp-c-brand-1) 100%, transparent 85%);
    color: var(--vp-c-brand-1);
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 500;
  }

  /* ---- CTA Section ---- */
  .cta-section {
    margin-top: 80px;
    padding: 60px 40px;
    background: linear-gradient(135deg, var(--vp-c-bg-soft) 0%, rgba(230,57,70,.03) 100%);
    border: 1px solid var(--vp-c-divider);
    border-radius: 20px;
    text-align: center;
  }

  .cta-content h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0 0 12px;
  }

  .cta-content p {
    font-size: 1rem;
    color: var(--vp-c-text-2);
    margin: 0 0 24px;
  }

  .btn-cta {
    display: inline-block;
    padding: 12px 28px;
    background: linear-gradient(135deg, #e63946, #c1121f);
    color: white;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.25);
  }

  /* ---- 响应式 ---- */
  @media (max-width: 768px) {
    .hero { padding: 60px 0 50px; }
    .hero-title { font-size: 3rem; }
    .hero-subtitle { font-size: 1.2rem; }
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .card-tech, .card-finance { grid-column: span 2; grid-row: span 1; }
    .recent-list { grid-template-columns: 1fr; }
    .cta-section { padding: 40px 24px; }
    .cta-content h2 { font-size: 1.4rem; }
  }
</style>